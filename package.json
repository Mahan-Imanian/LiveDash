{
	"name": "livedash",
	"description": "A new tab that learns where you go and gets you there in one keystroke. Switches to open tabs, reopens closed ones, saves things for later. Private and local.",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Mahan-Imanian/LiveDash.git"
	},
	"engines": {
		"node": ">=22.6"
	},
	"scripts": {
		"dev": "wxt",
		"build": "wxt build",
		"zip": "wxt zip",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "node --test \"tests/**/*.test.ts\"",
		"check": "npm run typecheck && npm run lint && npm test",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.14",
		"@types/node": "^22.20.5",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@wxt-dev/module-react": "^1.2.2",
		"typescript": "^5.9.3",
		"wxt": "^0.21.4"
	}
}
