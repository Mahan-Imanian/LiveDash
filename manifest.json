{
  "manifest_version": 3,
  "name": "DashLive",
  "description": "DashLive transforms your new tab into an interactive personalized dashboard.",
  "version": "30.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "search",
    "identity"
  ],
  "optional_permissions": [
    "tabs",
    "tabGroups",
    "bookmarks",
    "identity"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dashlive@codersays.com"
    }
  },
  "action": {
    "default_title": "Open DashLive Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*",
    "https://livedash.codersays.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "short_name": "DashLive"
}
