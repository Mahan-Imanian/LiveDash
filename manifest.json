{
  "manifest_version": 3,
  "name": "LiveDash",
  "short_name": "LiveDash",
  "version": "21.0.0",
  "description": "An interactive, polished, personalized new tab dashboard for Chrome.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "LiveDash Quick Actions",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "bookmarks",
    "activeTab",
    "sidePanel",
    "identity"
  ],
  "host_permissions": [
    "https://livedash.codersays.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://livedash.codersays.com/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
  }
}