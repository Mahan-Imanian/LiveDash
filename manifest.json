{
  "manifest_version": 3,
  "name": "DashLive",
  "description": "A polished personalized new tab dashboard for Chrome.",
  "version": "32.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "bookmarks",
    "identity",
    "storage"
  ],
  "optional_permissions": [
    "tabs",
    "tabGroups",
    "bookmarks",
    "identity"
  ],
  "action": {
    "default_title": "Open LiveDash Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://livedash.codersays.com/*",
    "https://accounts.google.com/*",
    "https://oauth2.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://www.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "short_name": "DashLive",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
  }
}