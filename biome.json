{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!.output", "!.wxt", "!node_modules"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off"
			},
			"a11y": {
				"noAutofocus": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"src/features/palette/Palette.tsx",
				"src/features/tasks/Today.tsx",
				"src/features/shortcuts/**",
				"src/features/settings/**",
				"src/ui/**"
			],
			"linter": {
				"rules": {
					"a11y": {
						"useSemanticElements": "off",
						"noStaticElementInteractions": "off",
						"useKeyWithClickEvents": "off",
						"useFocusableInteractive": "off"
					}
				}
			}
		}
	]
}
